<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<fx:root prefHeight="-Infinity" prefWidth="-Infinity" type="BorderPane" xmlns="http://javafx.com/javafx/25.0.0" xmlns:fx="http://javafx.com/fxml/1">
  <center>
    <BorderPane>
      <center>
        <!-- CONTENT AREA -->
        <SplitPane fx:id="centerSplitPane" dividerPositions="1.0" BorderPane.alignment="CENTER" orientation="VERTICAL">
          <StackPane fx:id="contentStack">
            <!-- WELCOME PANE: only visible while no tab is open -->
            <StackPane fx:id="welcomePane"
              stylesheets="@../../style/center.css"
              styleClass="welcomePane">
              <!-- Logo watermark in the bottom right corner -->
              <ImageView fitWidth="460.0"
                preserveRatio="true"
                mouseTransparent="true"
                StackPane.alignment="BOTTOM_RIGHT">
                <Image url="@../../assets/logo.png"/>
                <StackPane.margin>
                  <Insets right="16.0" bottom="16.0"/>
                </StackPane.margin>
              </ImageView>
              <VBox alignment="TOP_LEFT"
                spacing="8.0"
                styleClass="welcomeContent">
                <Label fx:id="welcomeLabel" text="%welcome_title" styleClass="welcomeTitle"/>
                <Label fx:id="welcomeSubtitle" text="%welcome_subtitle" styleClass="welcomeSubtitle">
                  <VBox.margin>
                    <Insets bottom="8.0"/>
                  </VBox.margin>
                </Label>
                <Button fx:id="openLauncherButton"
                  text="%welcome_open_launcher"
                  styleClass="welcomeButton">
                  <graphic>
                    <Region styleClass="welcomeButtonIcon"/>
                  </graphic>
                </Button>
              </VBox>
            </StackPane>
            <TabPane fx:id="tabPane" tabClosingPolicy="ALL_TABS">
              <tabs/>
            </TabPane>
          </StackPane>
          <fx:include source="console/console.fxml" fx:id="console"/>
        </SplitPane>
      </center>

      <bottom>
        <HBox xmlns:fx="http://javafx.com/fxml/1"
          fx:id="bottomPanelContainer"
          alignment="CENTER_RIGHT"
          prefHeight="40.0"
          prefWidth="200.0"
          spacing="10.0"
          xmlns="http://javafx.com/javafx/25.0.0">
          <ToggleButton fx:id="consolePaneToggleButton">
            <tooltip>
              <Tooltip text="%console_togglebutton_tooltip"/>
            </tooltip>
            <graphic>
              <ImageView fitHeight="15.0" fitWidth="15.0" pickOnBounds="true" preserveRatio="true">
                <Image url="@../../assets/icons/console_button.png"/>
              </ImageView>
            </graphic>
          </ToggleButton>

          <Region HBox.hgrow="ALWAYS"/>
          <padding>
            <Insets right="8.0" left="8.0" top="8.0" bottom="8.0"/>
          </padding>

          <Label fx:id="statusLabel" text="%ideasy_ready_msg"/>
          <ProgressBar fx:id="statusProgressBar"
            prefWidth="0.0"
            progress="0.0"
            visible="false"/>
        </HBox>
      </bottom>
    </BorderPane>
  </center>
</fx:root>
