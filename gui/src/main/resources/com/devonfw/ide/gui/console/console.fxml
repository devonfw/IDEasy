<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<AnchorPane
  xmlns:fx="http://javafx.com/fxml"
  xmlns="http://javafx.com/javafx"
  fx:controller="com.devonfw.ide.gui.console.ConsoleController"
  prefWidth="Infinity"
  style="-fx-background-color: #FFFFF; -fx-border-color: #cccccc; -fx-border-width: 1;"
  AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
  AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
  fx:id="consoleRoot"
  minHeight="0"
>

  <VBox spacing="5" minWidth="-Infinity" style="-fx-border-color: #cccccc; -fx-border-width: 1 0 0 0;" AnchorPane.topAnchor="0"
    AnchorPane.bottomAnchor="0"
    AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
    <padding>
      <Insets top="5" right="5" bottom="5" left="5"/>
    </padding>

    <HBox spacing="10" style="-fx-padding: 5;" alignment="CENTER_LEFT">
      <Label text="%console_title" style="-fx-font-weight: bold; -fx-font-size: 12;" HBox.hgrow="ALWAYS"/>
      <Separator orientation="VERTICAL" style="-fx-padding: 0;"/>

      <Button fx:id="clearButton" text="%console_clear" prefWidth="60" style="-fx-font-size: 11;"/>

      <Region HBox.hgrow="ALWAYS"/>

      <CheckBox fx:id="autoScrollCheckBox" text="%console_auto_scroll" selected="true" style="-fx-font-size: 11;"/>
    </HBox>

    <Separator/>

    <ListView fx:id="consoleListView" VBox.vgrow="ALWAYS"
      style="-fx-font-family: 'Consolas', monospace; -fx-font-size: 11; -fx-control-inner-background: #f5f5f5;"/>

    <HBox spacing="10" style="-fx-padding: 3; -fx-border-color: #e0e0e0; -fx-border-width: 1 0 0 0;">
      <Label fx:id="consoleStatusLabel" text="%console_status_ready" style="-fx-font-size: 10; -fx-text-fill: #666666;"/>
      <Region HBox.hgrow="ALWAYS"/>
      <Label fx:id="lineCountLabel" text="%console_line_count" style="-fx-font-size: 10; -fx-text-fill: #666666;"/>
    </HBox>
  </VBox>
</AnchorPane>
