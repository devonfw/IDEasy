<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import java.lang.Double?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="com.devonfw.ide.gui.MainController"
  fx:id="rootPane"
  maxHeight="-Infinity"
  maxWidth="-Infinity"
  VBox.vgrow="ALWAYS"
  xmlns="http://javafx.com/javafx/25.0.0"
  xmlns:fx="http://javafx.com/fxml/1">

  <left>
    <VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:id="navigationPanel"
      prefHeight="428.0"
      prefWidth="181.0"
      spacing="4.0"
      stylesheets="@style/navigation.css"
      xmlns="http://javafx.com/javafx/25.0.0">
      <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
      </padding>

      <HBox alignment="CENTER_LEFT" prefWidth="200.0">
        <VBox.margin>
          <Insets bottom="10.0"/>
        </VBox.margin>
        <!-- Wrap logo in a StackPane so we can overlay an upgrade indicator in the top-right corner -->
        <StackPane>
          <children>
            <ImageView fx:id="logoImage"
              fitHeight="150.0"
              fitWidth="200.0"
              pickOnBounds="true"
              preserveRatio="true">
              <Image url="@assets/logo.png"/>
            </ImageView>
            <StackPane fx:id="upgradeIndicator" prefHeight="20.0" prefWidth="20.0" translateX="100" translateY="-15" pickOnBounds="true" visible="false"
              StackPane.alignment="TOP_RIGHT">
              <children>
                <Circle radius="10.0" fill="#BF362C"/>
                <Circle radius="8.0" fill="#F7CA41"/>
                <Label text="!" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #BF362C;"/>
              </children>
              <StackPane.margin>
                <Insets top="2.0" right="2.0"/>
              </StackPane.margin>
            </StackPane>
          </children>
        </StackPane>
      </HBox>

      <VBox maxHeight="-Infinity"
        prefWidth="100.0"
        styleClass="sideNavigationElement">
        <padding>
          <Insets left="8.0" right="8.0"/>
        </padding>
        <Label fx:id="labelProject"
          maxWidth="1.7976931348623157E308"
          text="%project"/>
        <ComboBox fx:id="selectedProject"
          maxWidth="1.7976931348623157E308"
          minWidth="-Infinity"
          prefHeight="40.0"
          prefWidth="150.0"
          promptText="%chooseProject"
          styleClass="chooseProject"/>
        <StackPane fx:id="updateIndicator" prefHeight="24.0" prefWidth="24.0" translateX="100" translateY="-50" visible="false"
          StackPane.alignment="TOP_RIGHT" pickOnBounds="false" style="-fx-cursor: hand;">
          <children>
            <ImageView fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true">
              <image>
                <Image url="@assets/update.png"/>
              </image>
            </ImageView>
          </children>
        </StackPane>
      </VBox>

      <VBox maxHeight="-Infinity"
        prefWidth="100.0"
        styleClass="sideNavigationElement">
        <padding>
          <Insets left="8.0" right="8.0"/>
        </padding>
        <Label fx:id="labelWorkspace"
          maxWidth="1.7976931348623157E308"
          text="%workspace"/>
        <ComboBox fx:id="selectedWorkspace"
          disable="true"
          maxWidth="1.7976931348623157E308"
          minWidth="-Infinity"
          prefHeight="40.0"
          prefWidth="150.0"
          promptText="%chooseWorkspace"
          styleClass="chooseProject"
          VBox.vgrow="ALWAYS"/>
      </VBox>

      <!-- Language selector -->
      <VBox maxHeight="-Infinity"
        prefWidth="100.0"
        styleClass="sideNavigationElement">
        <padding>
          <Insets left="8.0" right="8.0"/>
        </padding>
        <Label fx:id="labelLanguage"
          maxWidth="1.7976931348623157E308"
          text="%language"/>
        <ComboBox fx:id="selectedLanguage"
          maxWidth="1.7976931348623157E308"
          minWidth="-Infinity"
          prefHeight="40.0"
          prefWidth="150.0"
          promptText="%chooseLanguage"
          styleClass="chooseProject"/>
      </VBox>
    </VBox>

  </left>

  <center>
    <BorderPane>
      <center>
        <!-- Project header: updated by controller when selectedProject changes -->
        <!-- Project header: updated by controller when selectedProject changes -->
        <Label fx:id="projectHeaderLabel" maxWidth="1.7976931348623157E308"
          style="-fx-font-size: 24px; -fx-font-weight: 800; -fx-text-fill: #333333;"
          text="">
          <VBox.margin>
            <Insets left="30.0" top="24.0" right="30.0"/>
          </VBox.margin>
        </Label>
        <!-- CONTENT AREA -->
        <SplitPane fx:id="centerSplitPane" dividerPositions="1.0" BorderPane.alignment="CENTER" orientation="VERTICAL">
          <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER">
            <StackPane prefHeight="150.0">
              <fx:define>
                <Double fx:id="buttonContainerHeight" fx:value="80.0"/>
                <Double fx:id="buttonContainerWidth" fx:value="150.0"/>
              </fx:define>

              <VBox maxHeight="1.7976931348623157E308"
                maxWidth="1.7976931348623157E308"
                prefHeight="231.0"
                spacing="12.0">
                <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                </padding>

                <!-- Android Studio -->
                <HBox alignment="CENTER_LEFT"
                  prefHeight="100.0"
                  prefWidth="150.0"
                  spacing="20.0"
                  stylesheets="@style/center.css"
                  styleClass="ideElement">
                  <ImageView fitHeight="60.0"
                    fitWidth="60.0"
                    pickOnBounds="true"
                    preserveRatio="true">
                    <HBox.margin>
                      <Insets bottom="10.0" left="10.0" top="10.0"/>
                    </HBox.margin>
                    <Image url="@assets/as.png"/>
                  </ImageView>

                  <Label prefHeight="30.0"
                    prefWidth="190.0"
                    styleClass="ideTitle"
                    text="Android-Studio"/>

                  <HBox alignment="CENTER_RIGHT"
                    prefHeight="$buttonContainerHeight"
                    prefWidth="$buttonContainerWidth"
                    minWidth="$buttonContainerWidth"
                    spacing="10.0"
                    HBox.hgrow="ALWAYS">
                    <Button fx:id="androidStudioOpen"
                      disable="true"
                      mnemonicParsing="false"
                      onAction="#openAndroidStudio"
                      styleClass="launchButton"
                      text="%open">
                      <HBox.margin>
                        <Insets right="20.0"/>
                      </HBox.margin>
                    </Button>
                  </HBox>
                </HBox>

                <!-- Eclipse -->
                <HBox alignment="CENTER_LEFT"
                  prefHeight="100.0"
                  prefWidth="150.0"
                  spacing="20.0"
                  styleClass="ideElement"
                  stylesheets="@style/center.css">
                  <ImageView fitHeight="60.0"
                    fitWidth="60.0"
                    pickOnBounds="true"
                    preserveRatio="true">
                    <HBox.margin>
                      <Insets bottom="10.0" left="10.0" top="10.0"/>
                    </HBox.margin>
                    <Image url="@assets/eclipse.png"/>
                  </ImageView>

                  <Label prefHeight="30.0"
                    prefWidth="114.0"
                    styleClass="ideTitle"
                    text="Eclipse"/>

                  <HBox alignment="CENTER_RIGHT"
                    prefHeight="$buttonContainerHeight"
                    prefWidth="$buttonContainerWidth"
                    minWidth="$buttonContainerWidth"
                    HBox.hgrow="ALWAYS">
                    <Button fx:id="eclipseOpen"
                      disable="true"
                      mnemonicParsing="false"
                      onAction="#openEclipse"
                      styleClass="launchButton"
                      text="%open">
                      <HBox.margin>
                        <Insets right="20.0"/>
                      </HBox.margin>
                    </Button>
                  </HBox>
                </HBox>

                <!-- IntelliJ -->
                <HBox alignment="CENTER_LEFT"
                  prefHeight="100.0"
                  prefWidth="150.0"
                  spacing="20.0"
                  styleClass="ideElement"
                  stylesheets="@style/center.css">
                  <ImageView fitHeight="60.0"
                    fitWidth="60.0"
                    pickOnBounds="true"
                    preserveRatio="true">
                    <HBox.margin>
                      <Insets bottom="10.0" left="10.0" top="10.0"/>
                    </HBox.margin>
                    <Image url="@assets/intellij.png"/>
                  </ImageView>

                  <Label prefHeight="30.0"
                    prefWidth="100.0"
                    styleClass="ideTitle"
                    text="IntelliJ"/>

                  <HBox alignment="CENTER_RIGHT"
                    prefHeight="$buttonContainerHeight"
                    prefWidth="$buttonContainerWidth"
                    minWidth="$buttonContainerWidth"
                    spacing="10.0"
                    HBox.hgrow="ALWAYS">
                    <Button fx:id="intellijOpen"
                      disable="true"
                      mnemonicParsing="false"
                      onAction="#openIntellij"
                      styleClass="launchButton"
                      text="%open">
                      <HBox.margin>
                        <Insets right="20.0"/>
                      </HBox.margin>
                    </Button>
                  </HBox>
                </HBox>

                <!-- VS Code -->
                <HBox alignment="CENTER_LEFT"
                  prefHeight="100.0"
                  prefWidth="150.0"
                  spacing="20.0"
                  styleClass="ideElement"
                  stylesheets="@style/center.css">
                  <ImageView fitHeight="60.0"
                    fitWidth="60.0"
                    pickOnBounds="true"
                    preserveRatio="true">
                    <HBox.margin>
                      <Insets bottom="10.0" left="10.0" top="10.0"/>
                    </HBox.margin>
                    <Image url="@assets/vscode.png"/>
                  </ImageView>

                  <Label prefHeight="30.0"
                    prefWidth="114.0"
                    styleClass="ideTitle"
                    text="VS Code"/>

                  <HBox alignment="CENTER_RIGHT"
                    prefHeight="$buttonContainerHeight"
                    prefWidth="$buttonContainerWidth"
                    minWidth="$buttonContainerWidth"
                    spacing="10.0"
                    HBox.hgrow="ALWAYS">
                    <Button fx:id="vsCodeOpen"
                      disable="true"
                      mnemonicParsing="false"
                      onAction="#openVsCode"
                      styleClass="launchButton"
                      text="%open">
                      <HBox.margin>
                        <Insets right="20.0"/>
                      </HBox.margin>
                    </Button>
                  </HBox>
                </HBox>
              </VBox>
            </StackPane>
          </ScrollPane>

          <fx:include source="console/console.fxml" fx:id="console"/>
        </SplitPane>
      </center>

      <bottom>
        <HBox xmlns:fx="http://javafx.com/fxml/1"
          fx:id="bottomPanelContainer"
          alignment="CENTER_RIGHT"
          prefHeight="40.0"
          prefWidth="200.0"
          spacing="10.0"
          xmlns="http://javafx.com/javafx/25.0.0">
          <ToggleButton fx:id="consolePaneToggleButton">
            <tooltip>
              <Tooltip text="%console_togglebutton_tooltip"/>
            </tooltip>
            <graphic>
              <ImageView fitHeight="15.0" fitWidth="15.0" pickOnBounds="true" preserveRatio="true">
                <Image url="@assets/icons/console_button.png"/>
              </ImageView>
            </graphic>
          </ToggleButton>

          <Region HBox.hgrow="ALWAYS"/>
          <padding>
            <Insets right="8.0" left="8.0" top="8.0" bottom="8.0"/>
          </padding>

          <Label fx:id="statusLabel" text="IDEasy is ready."/>
          <ProgressBar fx:id="statusProgressBar"
            prefWidth="0.0"
            progress="0.0"
            visible="false"/>
        </HBox>
      </bottom>
    </BorderPane>
  </center>
</BorderPane>
