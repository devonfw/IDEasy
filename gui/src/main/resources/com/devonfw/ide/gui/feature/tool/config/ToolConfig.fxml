<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<fx:root fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" type="ScrollPane" xmlns="http://javafx.com/javafx/25.0.0"
  xmlns:fx="http://javafx.com/fxml/1">
  <BorderPane>
    <top>
      <HBox spacing="10.0" style="-fx-font-weight: bold; -fx-font-size: 12; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
        <padding>
          <Insets top="10.0" right="10.0" bottom="10.0" left="40.0"/>
        </padding>
        <Label text="%tool_config.column.enable" prefWidth="40.0"/>
        <Label text="%tool_config.column.tool" prefWidth="120.0" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
        <Label text="%tool_config.column.edition" prefWidth="130.0" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
        <Label text="%tool_config.column.version" prefWidth="130.0" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
      </HBox>
    </top>
    <center>
      <TreeView fx:id="toolsTree" style="-fx-font-size: 10;">
        <BorderPane.margin>
          <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
        </BorderPane.margin>
      </TreeView>
    </center>
    <bottom>
      <HBox spacing="10.0" alignment="CENTER_RIGHT">
        <padding>
          <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
        </padding>
        <Button fx:id="previewButton" text="%tool_config.preview"/>
        <Button fx:id="saveButton" text="%tool_config.save"/>
      </HBox>
    </bottom>
  </BorderPane>
</fx:root>
