#!/usr/bin/env bash
# this script should be sourced, shebang above only for syntax highlighting in editors
function ide() {
  local return_code
  local ide_env
  if [ $# != 0 ]; then
    ideasy ${IDE_OPTIONS} "$@"
    return_code=$?
    if [ $return_code != 0 ]; then
      echo -e "\n\033[91mError: IDEasy failed with exit code ${return_code}\033[91m" >&2
      return ${return_code}
    fi
    local _create_project
    _create_project="$(_ide_create_project "$@")"
    if [ -n "${_create_project}" ] && [ -d "${IDE_ROOT}/${_create_project}" ]; then
      cd "${IDE_ROOT}/${_create_project}" || return 1
    fi
  fi
  unset IDE_HOME
  unset WORKSPACE
  ide_env="$(ideasy ${IDE_OPTIONS} env --bash)"
  if [ $? = 0 ]; then
    eval "${ide_env}"
    if [ $# = 0 ] && [ -n "${IDE_HOME}" ]; then
      echo "IDE environment variables have been set for ${IDE_HOME} in workspace ${WORKSPACE}"
    fi
  fi
  if [ "${OSTYPE}" = "cygwin" ] && [ "$#" != 0 ]; then
    echo -e "\033[93m--- WARNING: CYGWIN IS NOT SUPPORTED ---\nCygwin console is not supported by IDEasy.\nConsider using the git terminal instead.\nIf you want to use Cygwin with IDEasy, you will have to configure it yourself.\nA few suggestions and caveats can be found here:\nhttps://github.com/devonfw/IDEasy/blob/main/documentation/cygwin.adoc\n\033[39m"
  fi
}

function icd() {
  if [ $# = 1 ] && [ "${1:0:1}" != "-" ]; then
    cd $1 || return 1
    ide
    return
  elif [ $# = 0 ]; then
    if [ "${IDE_HOME}" != "" ]; then
      cd "${IDE_HOME}"
      ide
      return
    else
      cd "${IDE_ROOT}"
      return
    fi
  fi
  local icd_project=
  local icd_workspace=
  while [ $# != 0 ]; do
    case "$1" in
      -p|--project)
        shift
        icd_project=$1
        shift
        ;;
      -w|--workspace)
        shift
        if [ $# != 0 ] && [ "${1:0:1}" != "-" ]; then
          icd_workspace=$1
          shift
        else
          icd_workspace=main
        fi
        ;;
      -h|--help)
        echo "USAGE: icd [-p «project»] [-w [«workspace»]]"
        echo
        echo "Change directory and initialize IDEasy environment."
        echo "The icd command can be used as an alternative to the regular cd command."
        echo "As additional effect, it will automatically update your environment variables."
        echo "Futher, it allows shortcuts to quickly navigate to common directories of IDEasy."
        echo "Without any arguments icd will navigate to your top-level project directory (IDE_HOME)."
        echo
        echo "OPTIONS:"
        echo "  -p | --project   «project»   The IDEasy project to cd to."
        echo "  -w | --workspace «workspace» The workspace inside your IDEasy project to cd to. Defaults to main."
        echo "  -h | --help                  Print this help text."
        return
        ;;
      *)
        echo "Unknown option $1"
        return 1
    esac
  done
  local icd_path=${IDE_ROOT}
  
  # Determine the project to use
  if [ "${icd_project}" != "" ]; then
    # Project explicitly specified
    icd_path=${icd_path}/${icd_project}
  elif [ "${icd_workspace}" != "" ]; then
    # Workspace specified without project - infer project from current directory or IDE_HOME
    local current_project=""
    local current_dir="$(pwd)"
    if [[ "${current_dir}" == "${IDE_ROOT}"/* ]]; then
      # Extract project from current directory
      local relative_path="${current_dir#${IDE_ROOT}/}"
      current_project="${relative_path%%/*}"
    elif [ "${IDE_HOME}" != "" ] && [[ "${IDE_HOME}" == "${IDE_ROOT}"/* ]]; then
      # Fall back to extracting project from IDE_HOME
      local relative_path="${IDE_HOME#${IDE_ROOT}/}"
      current_project="${relative_path%%/*}"
    fi
    
    if [ "${current_project}" != "" ]; then
      icd_path=${IDE_ROOT}/${current_project}
    elif [ "${IDE_HOME}" != "" ]; then
      icd_path=${IDE_HOME}
    fi
  elif [ "${IDE_HOME}" != "" ]; then
    # No project or workspace specified - use IDE_HOME
    icd_path=${IDE_HOME}
  fi
  
  # Append workspace path if specified
  if [ "${icd_workspace}" != "" ]; then
    icd_path=${icd_path}/workspaces/${icd_workspace}
  fi
  
  cd "${icd_path}" || return 1
  ide
  return
}

_ide_create_project()
{
  local found_create=false
  while [ $# != 0 ]; do
    case "$1" in
      create)
        found_create=true
        ;;
      -*)
        ;;
      *)
        if [ "${found_create}" = true ]; then
          echo "$1"
          return
        fi
        ;;
    esac
    shift
  done
}

# remove ":" from word breaks so completion keeps arguments like "dependency:list" together.
if [ -n "${COMP_WORDBREAKS:-}" ]; then
  COMP_WORDBREAKS=${COMP_WORDBREAKS//:}
fi

_ide_completion()
{
  set -f
  if [ -z "${COMP_WORDS[COMP_CWORD]}" ]; then
    COMPREPLY=( $(ideasy -q complete ${COMP_WORDS[@]:1} "") )
  else
    COMPREPLY=( $(ideasy -q complete ${COMP_WORDS[@]:1}) )
  fi

  # keywords ending with "=" remove whitespace
  for reply in "${COMPREPLY[@]}"; do
    if [[ "${reply}" == *= ]]; then
      compopt -o nospace
      break
    fi
  done

  set +f
}

if [ "${0/*\//}" = "zsh" ]; then
  autoload -Uz compinit
  compinit
  autoload bashcompinit
  bashcompinit
fi

if [ "${OSTYPE}" = "msys" ]; then
  IDE_ROOT="$(cygpath "${IDE_ROOT}")"
fi
if ! command -v ideasy &> /dev/null; then
  export PATH="${PATH}:${IDE_ROOT}/_ide/installation/bin"
fi

# echoes the names of the sub-directories of $1 that start with $2
_icd_list_dirs()
{
  local base="$1" cur="$2" dir names=()
  [ -d "${base}" ] || return
  for dir in "${base}"/*/; do
    [ -d "${dir}" ] && names+=("$(basename "${dir}")")
  done
  compgen -W "${names[*]}" -- "${cur}"
}

# echoes the IDEasy projects (sub-directories of IDE_ROOT with a 'workspaces' and 'settings' folder) that start with $1
_icd_list_projects()
{
  local cur="$1" dir names=()
  [ -d "${IDE_ROOT}" ] || return
  for dir in "${IDE_ROOT}"/*/; do
    if [ -d "${dir}workspaces" ] && [ -d "${dir}settings" ]; then
      names+=("$(basename "${dir}")")
    fi
  done
  compgen -W "${names[*]}" -- "${cur}"
}

# echoes the path of the project given as $1 or, if empty, the project inferred from PWD or IDE_HOME (same logic as icd())
_icd_project_dir()
{
  local project="$1"
  if [ -n "${project}" ]; then
    echo "${IDE_ROOT}/${project}"
    return
  fi
  local current_dir
  current_dir="$(pwd)"
  if [[ "${current_dir}" == "${IDE_ROOT}"/* ]]; then
    local relative_path="${current_dir#${IDE_ROOT}/}"
    echo "${IDE_ROOT}/${relative_path%%/*}"
  elif [ -n "${IDE_HOME}" ]; then
    echo "${IDE_HOME}"
  fi
}

# echoes the workspaces of project $1 that start with $2
_icd_list_workspaces()
{
  local project_dir
  project_dir="$(_icd_project_dir "$1")"
  [ -n "${project_dir}" ] && _icd_list_dirs "${project_dir}/workspaces" "$2"
}

# echoes the repositories (folders inside a workspace) of project $1, optionally restricted to workspace $2, that start with $3
_icd_list_repositories()
{
  local project_dir workspace="$2" cur="$3"
  project_dir="$(_icd_project_dir "$1")"
  [ -n "${project_dir}" ] || return
  if [ -n "${workspace}" ]; then
    _icd_list_dirs "${project_dir}/workspaces/${workspace}" "${cur}"
  else
    local ws_dir repo_dir names=()
    for ws_dir in "${project_dir}"/workspaces/*/; do
      [ -d "${ws_dir}" ] || continue
      for repo_dir in "${ws_dir}"*/; do
        [ -d "${repo_dir}" ] && names+=("$(basename "${repo_dir}")")
      done
    done
    compgen -W "${names[*]}" -- "${cur}" | sort -u
  fi
}

_icd_completion()
{
  local cur="${COMP_WORDS[COMP_CWORD]}" prev="${COMP_WORDS[COMP_CWORD-1]}"
  local icd_comp_project= icd_comp_workspace= i

  for (( i=1; i<COMP_CWORD; i++ )); do
    case "${COMP_WORDS[i]}" in
      -p|--project) icd_comp_project="${COMP_WORDS[i+1]}" ;;
      -w|--workspace) icd_comp_workspace="${COMP_WORDS[i+1]}" ;;
    esac
  done

  case "${prev}" in
    -p|--project)
      COMPREPLY=( $(_icd_list_projects "${cur}") )
      return
      ;;
    -w|--workspace)
      COMPREPLY=( $(_icd_list_workspaces "${icd_comp_project}" "${cur}") )
      return
      ;;
    -r|--repository)
      COMPREPLY=( $(_icd_list_repositories "${icd_comp_project}" "${icd_comp_workspace}" "${cur}") )
      return
      ;;
  esac

  COMPREPLY=( $(compgen -W "-p --project -w --workspace -r --repository -h --help" -- "${cur}") )
}

complete -F _ide_completion ide
complete -F _icd_completion icd
ide

