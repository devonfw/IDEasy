#!/bin/bash
if [ "$1" = "python" ] && [ "$2" = "list" ]; then
  echo '[{"version": "3.12.12", "implementation": "cpython"}]'
  exit 0
fi
echo "uv $*"
cd $(dirname $0)
cd ../../../../../..
pwd
# Normalize backslash paths (e.g. "C:\a\b") to forward slashes so they can be used by bash.
normalize() { printf '%s' "$1" | tr '\\' '/'; }
# Pristine interpreter install: uv python install --install-dir <dir> <version>
# uv lays the interpreter out in a nested "cpython-«version»-«platform»" folder, mirroring the real layout.
if [ "$1" = "python" ] && [ "$2" = "install" ]; then
  install_dir="$(normalize "$4")"
  version="$5"
  interp_dir="${install_dir}/cpython-${version}-x86_64-unknown-linux-gnu"
  mkdir -p "${interp_dir}/bin"
  cp -a repository/python/python/default/bin/python "${interp_dir}/bin/python"
  exit 0
elif [ "$1" = "pip" ] && [ "$2" = "install" ]; then
  cp repository/pip/pip/default/bin/pip project/software/python/bin
# Virtual environment: either old-style "uv venv --python <ver>" or new-style "uv venv <target> --python <interpreter> ..."
elif [ "$1" = "venv" ]; then
  if [ "$2" = "--python" ]; then
    cp -a repository/python/python/default project/software/.venv
  else
    target="$(normalize "$2")"
    mkdir -p "${target}/bin"
    cp -a repository/python/python/default/bin/python "${target}/bin/python"
  fi
fi
