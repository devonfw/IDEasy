#!/bin/bash
# Simulates npm for tests. Global packages go into the per-project global prefix (npm_config_prefix).
# npm places the package launcher in the prefix root on Windows but in <prefix>/bin on POSIX, so the
# launcher location is chosen per platform (this must mirror Npm#setEnvironment, which adds the same
# platform-specific folder to the PATH).
npm_global_bin="$npm_config_prefix"
if [ "$OS" != "Windows_NT" ]; then
  npm_global_bin="$npm_config_prefix/bin"
fi
if [ "$1" = "--version" ]; then
  echo "9.9.2"
  exit
fi
if [ "$1" = "list" ] && [ "$2" = "-g" ]; then
  # Report a version only if the package launcher is actually present in the per-project global prefix
  # (pristine npm reports nothing for a package that is not installed yet).
  if [ -n "$npm_config_prefix" ] && [ -e "$npm_global_bin/$3" ]; then
    echo "-- $3@9.9.2"
  fi
  exit 1
fi
if [ "$1" = "install" ]; then
  # Pristine: global packages are installed into the per-project global prefix.
  if [ -n "$npm_config_prefix" ]; then
    mkdir -p "$npm_global_bin"
    cp target/ide-projects/yarn/repository/yarn/yarn/default/yarn "$npm_global_bin/yarn"
  fi
fi
echo "npm $*"
